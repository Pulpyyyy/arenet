#
# Step S.2 — systemd unit for native Linux installs (alternative
# to Docker). Used by packaging/systemd/install.sh which handles
# user creation + data-dir setup + unit placement.
#
# After install:
#   sudo systemctl enable --now arenet
#   sudo systemctl status arenet
#   sudo journalctl -u arenet -f
#
# Config is sourced from /etc/arenet/arenet.env (optional). The
# binary's defaults are sane; the env file is only needed to
# override admin bind / data dir / log level.

[Unit]
Description=Arenet — homelab reverse proxy with integrated security
Documentation=https://github.com/barto95100/arenet
After=network-online.target
Wants=network-online.target

# Restart rate limit (Step #S-10): these directives belong to
# [Unit], not [Service]. Putting them in [Service] makes systemd
# emit "Unknown key 'StartLimitIntervalSec' in section [Service],
# ignoring." and silently disables the rate limit.
StartLimitBurst=5
StartLimitIntervalSec=300

[Service]
Type=simple
User=arenet
Group=arenet

# Optional env-file. The "-" prefix means "ignore if missing"
# (don't fail-start when the operator hasn't created one).
# v2.50 — where the HTTP access log goes when the operator enables it
# in Settings. /var/log is the right place for a packaged service, and
# LogsDirectory= below is what makes it writable despite
# ProtectSystem=strict.
#
# Declared BEFORE EnvironmentFile= on purpose: systemd applies these in
# file order, so an operator who sets ARENET_ACCESS_LOG_PATH in
# /etc/arenet/arenet.env still wins.
Environment=ARENET_ACCESS_LOG_PATH=/var/log/arenet/access.log

EnvironmentFile=-/etc/arenet/arenet.env

# Default arguments. Operators override via the env file:
#   ARENET_ADMIN_BIND, ARENET_DATA_DIR, ARENET_LOG_LEVEL,
#   ARENET_ACCESS_LOG_PATH
# All map to the binary's flags via D5 precedence.
ExecStart=/usr/local/bin/arenet --data-dir=/var/lib/arenet

WorkingDirectory=/var/lib/arenet

# Bind privileged ports as the nonroot arenet user: :80 and :443
# for the HTTP routes, and any port below 1024 a v2.42 TCP/UDP
# service listens on (25, 465, 587, 993… for a mail relay).
# Without this capability the service is refused at validation
# time with the exact line to add — this is that line.
# CapabilityBoundingSet restricts the binary to ONLY this
# capability — no chroot, no audit, no sysadmin.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

# Filesystem hardening. The binary writes only to
# /var/lib/arenet; everything else is read-only or invisible.
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ReadWritePaths=/var/lib/arenet

# /var/log/arenet for the access log (v2.50). LogsDirectory= creates it
# owned by the service user and is IMPLICITLY excluded from
# ProtectSystem=, so it needs no ReadWritePaths entry of its own — and it
# survives stops and restarts, unlike RuntimeDirectory=.
#
# Created whether or not the log is enabled: an empty directory costs
# nothing, and creating it lazily would mean the first save after
# enabling failed on a read-only /var/log.
LogsDirectory=arenet

# Network hardening (allow only IPv4 + IPv6; no other address
# families needed). RestrictAddressFamilies is intentionally
# permissive on AF_NETLINK so Caddy can read interface info
# for its bind logic.
RestrictAddressFamilies=AF_INET AF_INET6 AF_NETLINK AF_UNIX
LockPersonality=true

# Go's runtime needs writable+exec in some code paths; a tighter
# value (MemoryDenyWriteExecute=true) breaks startup. Step #S-10:
# inline comments after `=value` are NOT supported by systemd —
# they get parsed as part of the value and rejected as
# "Invalid argument". Comment block lives above the directive.
MemoryDenyWriteExecute=false
# Restart policy. Restart on crash; back off if we're failing
# repeatedly (don't spin a death loop hammering systemd).
Restart=on-failure
RestartSec=5s

# Stop timeout (defensive — Phase 5 follow-up batch).
# 15s = 10s admin server graceful Shutdown timeout
# (cmd/arenet/main.go:1366) + 5s Caddy grace_period
# (internal/caddymgr/manager.go:1475). systemd's default
# TimeoutStopSec is 90s; without an explicit cap an operator
# would wait 90s for a stuck shutdown before SIGKILL — long
# enough to feel broken even though the actual graceful path
# is well under 15s.
#
# Observed on Day 12: `arenet.service: State 'stop-sigterm'
# timed out. Killing.` at the 90s default. Root-cause
# investigation (likely candidates: obsRetention SQLite WAL
# flush, wafSink drain, WebSocket long-poll connections not
# closing on ctx cancel) deferred — the defensive cap here
# bounds the operator-visible delay while the root cause
# stays in the backlog.
TimeoutStopSec=15s

# Log routing — journald captures stdout/stderr by default. Set
# ARENET_LOG_FORMAT=json in the env file to get structured logs.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=arenet

[Install]
WantedBy=multi-user.target
